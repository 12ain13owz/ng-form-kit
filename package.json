{
  "name": "ng-form-kit",
  "version": "0.0.0",
  "scripts": {
    "build": "ng build ng-form-kit",
    "watch": "ng build ng-form-kit --watch --configuration development",
    "storybook": "ng run ng-form-kit:storybook",
    "build-storybook": "ng run ng-form-kit:build-storybook",
    "lint": "eslint .",
    "fix": "eslint . --fix && prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p projects/ng-form-kit/tsconfig.lib.json && tsc --noEmit -p projects/ng-form-kit/.storybook/tsconfig.json",
    "helm:fix": "node scripts/fix-helm-imports.mjs && prettier --write projects/ng-form-kit/src/lib/ui tsconfig.json"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ng-icons/core": ">=32.0.0 <34.0.0",
    "@ng-icons/lucide": ">=32.0.0 <34.0.0",
    "@spartan-ng/brain": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.3",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@spartan-ng/cli": "^1.9.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/angular-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.7",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.0"
  },
  "description": "Reactive Forms fields for Angular on spartan/ui — library workspace with Storybook",
  "engines": {
    "node": "^22.22.0 || >=24.0.0"
  }
}
